import plotly.graph_objects as go

c_scale=[[0,"rgb(47,168,84)"],[1,"rgb(209,0,0)"]]

def create_scatter(x, y, plot_type):
    # Create a 3D scatter plot of the data points
    return go.Scatter3d(
        x=x[:, 0],
        y=x[:, 1],
        z=y,
        mode='markers',
        marker=dict(
            size=6,
            color=y,
            colorscale=c_scale,
            opacity=0.8,
            line=dict(color='white', width=1)
        ),
        name=plot_type
    )

def format_plot(fig):
    # Apply basic layout formatting
    fig.update_layout(
        margin=dict(l=0, r=0, b=0, t=0),
        scene=dict(
            xaxis_title='X1',
            yaxis_title='X2',
            zaxis_title='Y'
        )
    )
    return fig
